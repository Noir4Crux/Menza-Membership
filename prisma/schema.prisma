generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  AdminID   String      @id @db.VarChar(10)
  NamaAdmin String      @db.VarChar(50)
  Transaksi Transaksi[]
}

model Barber {
  BarberID   String      @id @db.VarChar(10)
  NamaBarber String      @db.VarChar(50)
  Transaksi  Transaksi[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Detail_Transaksi {
  TransaksiID          String    @id @db.VarChar(10)
  LayananID            String    @db.VarChar(5)
  HargaSaatTransaksi   Decimal   @db.Decimal(10, 2)
  TransaksiTransaksiID String    @db.VarChar(10)
  Layanan              Layanan   @relation(fields: [LayananID], references: [LayananID], onDelete: NoAction, onUpdate: NoAction)
  Transaksi            Transaksi @relation(fields: [TransaksiTransaksiID], references: [TransaksiID], onDelete: Cascade, onUpdate: NoAction)

  @@index([TransaksiTransaksiID], map: "idx_detail_transaksi")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Layanan {
  LayananID        String             @id @db.VarChar(5)
  NamaLayanan      String             @db.VarChar(50)
  HargaLayanan     Decimal            @db.Decimal(10, 2)
  Detail_Transaksi Detail_Transaksi[]
}

model Member {
  MemberID                                   String      @id @db.VarChar(10)
  NamaMember                                 String      @db.VarChar(50)
  StatusMembership                           String      @db.VarChar(15)
  Membership                                 Membership  @relation(fields: [StatusMembership], references: [StatusMembership])
  Transaksi_Transaksi_MemberIDToMember       Transaksi[] @relation("Transaksi_MemberIDToMember")
  Transaksi_Transaksi_MemberMemberIDToMember Transaksi[] @relation("Transaksi_MemberMemberIDToMember")
}

model Membership {
  StatusMembership String      @id @db.VarChar(15)
  Benefit          String?     @db.VarChar(100)
  Member           Member[]
  Transaksi        Transaksi[]
}

model Owner {
  OwnerID   String      @id @db.VarChar(10)
  NamaOwner String      @db.VarChar(50)
  Transaksi Transaksi[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Transaksi {
  TransaksiID                             String             @id @db.VarChar(10)
  TanggalTransaksi                        DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  MemberID                                String             @db.VarChar(10)
  StatusMembership                        String             @db.VarChar(15)
  TotalTransaksi                          Decimal            @db.Decimal(10, 2)
  PoinDiperoleh                           Int?               @default(0)
  PoinDigunakan                           Int?               @default(0)
  Benefit                                 String?            @db.VarChar(20)
  AdminID                                 String             @db.VarChar(10)
  OwnerID                                 String?            @db.VarChar(10)
  BarberID                                String             @db.VarChar(10)
  MemberMemberID                          String?            @db.VarChar(10)
  Detail_Transaksi                        Detail_Transaksi[]
  Admin                                   Admin              @relation(fields: [AdminID], references: [AdminID], onDelete: NoAction, onUpdate: NoAction)
  Barber                                  Barber             @relation(fields: [BarberID], references: [BarberID], onDelete: NoAction, onUpdate: NoAction)
  Member_Transaksi_MemberIDToMember       Member             @relation("Transaksi_MemberIDToMember", fields: [MemberID], references: [MemberID], onDelete: NoAction, onUpdate: NoAction)
  Member_Transaksi_MemberMemberIDToMember Member?            @relation("Transaksi_MemberMemberIDToMember", fields: [MemberMemberID], references: [MemberID], onDelete: NoAction, onUpdate: NoAction)
  Owner                                   Owner?             @relation(fields: [OwnerID], references: [OwnerID], onDelete: NoAction, onUpdate: NoAction)
  Membership                              Membership         @relation(fields: [StatusMembership], references: [StatusMembership], onDelete: NoAction)

  @@index([MemberID], map: "idx_transaksi_member")
  @@index([TanggalTransaksi], map: "idx_transaksi_tanggal")
}
